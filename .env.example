# Copy to .env.local for local development. Values are injected at build time.

# Web3Forms access key — powers the contact form.
# Get one free at https://web3forms.com (see docs/OWNER-SETUP.md).
# This key is PUBLIC by design: it ships in the browser bundle. It is safe to expose —
# it only permits sending mail to the address that registered it.
VITE_WEB3FORMS_KEY=""

# Where the site is published. All defaults live in vite.config.ts; override here
# only to preview a different deployment target locally.
#   GitHub Pages project site -> leave unset (defaults to /AsemAlhammadi/)
#   Custom domain             -> VITE_BASE_PATH="/" and VITE_SITE_URL="https://example.com"
# VITE_BASE_PATH="/AsemAlhammadi/"
# VITE_SITE_URL="https://asemhammadi.github.io/AsemAlhammadi/"
