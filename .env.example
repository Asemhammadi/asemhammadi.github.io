# Copy to .env.local for local development. Values are injected at build time.

# Web3Forms access key — powers the contact form.
# Get one free at https://web3forms.com (see docs/OWNER-SETUP.md).
# This key is PUBLIC by design: it ships in the browser bundle. It is safe to expose —
# it only permits sending mail to the address that registered it.
VITE_WEB3FORMS_KEY=""

# Base path for the built site.
# GitHub Pages project site -> "/my-website/"  (the default)
# Custom domain or user site -> "/"
VITE_BASE_PATH="/my-website/"
